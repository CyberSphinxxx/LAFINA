# ==============================================================================
# LAFINA Backend & Cloud Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or backend/.env) and fill in your actual credentials.
# NEVER commit your actual .env file containing real API keys and secrets!
# ==============================================================================

# Render Production Deployment
ENVIRONMENT=production
API_BASE_URL=https://lafina.onrender.com

# Paste Render's Internal Database URL, then change only the scheme from
# postgresql:// to postgresql+asyncpg:// for SQLAlchemy's async driver.
# Keep the web service and database in the same Render region.
DATABASE_URL=postgresql+asyncpg://RENDER_DB_USER:RENDER_DB_PASSWORD@RENDER_INTERNAL_DB_HOST/RENDER_DB_NAME

# Bootstrap Admin Account
# On startup, LAFINA creates this account if it is missing, or promotes and
# reactivates the matching account. Store the real password only in Render.
ADMIN_EMAIL=admin@lafina.app
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_15_CHARACTERS

# Local development alternatives:
# ENVIRONMENT=development
# API_BASE_URL=http://localhost:8000
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lafina

# JWT RS256 Authentication Keys (Auto-generated in dev if omitted)
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ISSUER=lafina-auth
JWT_AUDIENCE=lafina-app
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cloud LLM & AI Services (Online Features)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Cloud Voice & Speech Services (Online TTS Preview)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Aoede

# Student Handbook RAG (online assistant quotes the USTP Student Handbook).
# Pinecone stores the passages and embeds them with its hosted model
# (llama-text-embed-v2, 768 dimensions), so this key and index are all it needs.
# Index the handbook once, from the repository root:
#   python -m backend.scripts.ingest_handbook --pdf path/to/ustp_handbook.pdf --replace
# Turn it on or off at runtime in the admin panel: Feature Flags > handbook_rag.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
# Optional overrides:
# HANDBOOK_NAMESPACE=ustp-handbook-2023
# HANDBOOK_MIN_SCORE=0.30

# ==============================================================================
# Google Workspace & Gmail API Integration (Milestone 6)
# ==============================================================================
# 1. Create a project in Google Cloud Console: https://console.cloud.google.com/
# 2. Enable the "Gmail API".
# 3. Configure OAuth Consent Screen with scopes:
#    - https://www.googleapis.com/auth/gmail.readonly
#    - https://www.googleapis.com/auth/gmail.compose
#    - https://www.googleapis.com/auth/gmail.modify
#    - https://www.googleapis.com/auth/userinfo.email
# 4. Create an OAuth 2.0 Web Client ID with Authorized Redirect URI:
#    https://lafina.onrender.com/v1/email/gmail/connect/callback
# 5. Insert your Client ID and Client Secret below:
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Optional override. If omitted, LAFINA derives this from API_BASE_URL.
# GOOGLE_REDIRECT_URI=https://lafina.onrender.com/v1/email/gmail/connect/callback

# AES-256-GCM Token Encryption Key for Stored User Refresh Tokens
# Generate a secure 32-byte secret (e.g. `openssl rand -hex 32` or standard passphrase):
GMAIL_TOKEN_ENCRYPTION_KEY=your_secure_32_byte_token_encryption_key_here
